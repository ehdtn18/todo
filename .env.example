# ── 이 파일을 복사해 .env.local 로 만들고 값을 채우세요 (.env.local 은 git 에 안 올라감) ──

# MySQL 연결 정보
# 로컬: localhost / 3306 / root
# 클라우드(TiDB Cloud, PlanetScale 등): 해당 서비스가 준 host/port/user/password/db 로 교체
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=1234
DB_NAME=todo

# SSL — 클라우드 MySQL 은 보통 필수. 켜려면 true.
# (TiDB Cloud, PlanetScale 등은 true 로 두세요. 로컬은 비워두거나 false)
DB_SSL=false
# 자체서명 CA 를 주는 호스트에서 인증 오류가 나면 false 로 (검증 끔). 기본 true.
# DB_SSL_REJECT_UNAUTHORIZED=true

# (선택) 서버리스에서 커넥션 한도가 빡빡하면 줄이세요. 기본 10.
# DB_POOL_LIMIT=5

# (선택) 파일 업로드를 Vercel Blob 으로 저장할 때.
# Vercel 프로젝트에 Blob 스토어를 연결하면 이 값이 자동 주입됩니다. 로컬에선 비워두면 public/uploads 에 저장됩니다.
# BLOB_READ_WRITE_TOKEN=
