# ── 이 파일을 복사해 .env.local 로 만들고 값을 채우세요 (.env.local 은 git 에 안 올라감) ──
# 실제 host/user/password 는 여기(공개 파일)에 적지 말고 .env.local 또는 Vercel 대시보드에만!

# MySQL 연결 정보
# 로컬: localhost / 3306 / root
# 클라우드(TiDB Cloud, PlanetScale 등): 서비스가 준 host/port/user/password/db 로 교체
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=todo

# SSL — 클라우드 MySQL 은 보통 필수(TiDB/PlanetScale=true). 로컬은 false.
DB_SSL=false
# DB_SSL_REJECT_UNAUTHORIZED=true   # 자체서명 CA 인증 오류 시 false 로
# DB_POOL_LIMIT=5                    # 서버리스 커넥션 한도가 빡빡하면

# 파일 업로드(선택): Vercel Blob 스토어 연결 시 BLOB_READ_WRITE_TOKEN 자동 주입.
# 로컬에선 비워두면 public/uploads 에 저장됩니다.
# BLOB_READ_WRITE_TOKEN=
